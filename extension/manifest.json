{
  "manifest_version": 3,
  "name": "Push It",
  "version": "2.2.18",
  "description": "Send links and notes privately between your devices.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png",
    "default_title": "Push It"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "activeTab",
    "alarms",
    "idle",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
